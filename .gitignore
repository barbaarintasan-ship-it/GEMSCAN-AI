# ============================================================
# GemScan AI — root .gitignore
# Written before `git init` specifically to keep node_modules,
# real secrets, and generated build output out of version control
# from the very first commit.
# ============================================================

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Environment / secrets ----
# Never commit real .env files. .env.example files ARE meant to be
# committed (they contain placeholders only) and are NOT excluded here.
.env
.env.local
.env.*.local
mobile/.env
supabase/functions/.env
supabase/.env

# ---- Expo generated files ----
.expo/
**/.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ---- React Native / Android build files ----
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/*.hprof
mobile/android/captures/
mobile/android/gradlew.log
*.apk
*.aab
*.ap_
*.dex

# Keep the shared, non-secret Android debug keystore out of git too —
# each environment/CI runner can generate its own debug key; it is not
# used for any release signing.
mobile/android/app/debug.keystore

# ---- React Native / iOS build files (for when iOS builds happen) ----
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/*.xcworkspace
mobile/ios/*.xcuserstate
*.ipa
*.mobileprovision

# ---- Metro / bundler caches ----
.metro-health-check*
metro.config.local.js

# ---- Supabase / Deno ----
supabase/.temp/
supabase/.branches/
.deno/

# ---- Test / coverage output ----
coverage/
*.lcov

# ---- Logs & temporary files ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
.tmp/
.cache/

# ---- OS junk files ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp

# ---- Claude Code local session data (not project source) ----
.claude/
