# Copy to .env and fill in. These are safe to expose in the mobile bundle
# (anon key + public URLs only) — no payment/API-vendor secrets ever go here.
# All AI vendor keys (Gemini/GPT/Claude) and payment keys (Stripe/PayPal/
# mobile money) live ONLY in Supabase Edge Function server-side env vars,
# never in this file or the mobile bundle.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project.functions.supabase.co

# Optional. If unset, error tracking/crash reporting no-ops (see lib/monitoring.ts).
EXPO_PUBLIC_SENTRY_DSN=
