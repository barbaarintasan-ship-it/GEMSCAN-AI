{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "../shared/**/*.test.ts",
    "../supabase/**/*.test.ts"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/geo-core/**/*.ts"
  ]
}
