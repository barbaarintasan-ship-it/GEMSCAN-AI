{
  "name": "gemscan-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "check:no-billing-deps": "node scripts/check-no-billing-deps.js",
    "preinstall": "node scripts/check-no-billing-deps.js",
    "postinstall": "patch-package",
    "prestart": "node scripts/check-no-billing-deps.js",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "~6.14.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tanstack/react-query": "^5.40.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^53.0.0",
    "expo-application": "~6.1.5",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-gl": "~15.1.7",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-keep-awake": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-location": "~18.1.6",
    "expo-print": "~14.1.4",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "h3-js": "^4.1.0",
    "i18next": "^23.11.5",
    "promise": "8.3.0",
    "react": "19.0.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.13.5"
  },
  "overrides": {
    "react-native": "0.79.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "comments": {
    "billingPolicy": "This app MUST NEVER depend on react-native-iap, expo-in-app-purchases, react-native-purchases, or any Google Play Billing / StoreKit wrapper. See scripts/check-no-billing-deps.js, which fails install/start if any banned package appears here. Payments happen ONLY on the official website — see /05-Monetization-Legal-Payments.md at the repo root."
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
