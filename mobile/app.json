{
  "expo": {
    "name": "GemScan AI",
    "slug": "gemestone",
    "owner": "gemestones-team",
    "version": "0.1.0",
    "scheme": "gemscanai",
    "userInterfaceStyle": "dark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "runtimeVersion": "0.1.0",
    "updates": {
      "url": "https://u.expo.dev/d24307ed-5428-4bbc-97ba-efd4a426856b",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "GemScan AI needs camera access to scan and identify gemstones, minerals, and jewelry."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GemScan AI can use your approximate (never exact) location to improve identification accuracy using local geological data. This is optional."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.gemscan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GemScan AI needs camera access to scan and identify gemstones, minerals, and jewelry."
      }
    },
    "android": {
      "package": "ai.gemscan.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0C"
      }
    },
    "extra": {
      "router": { "origin": false },
      "eas": {
        "projectId": "d24307ed-5428-4bbc-97ba-efd4a426856b"
      }
    }
  }
}
