# GemScan AI — Website environment template. Copy to .env.local and fill in.
# The Supabase publishable/anon key is browser-safe (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this website (auth + checkout return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Edge Functions base URL (same project).
SUPABASE_FUNCTIONS_URL=

# Store links (optional until published).
NEXT_PUBLIC_ANDROID_URL=
NEXT_PUBLIC_IOS_URL=
