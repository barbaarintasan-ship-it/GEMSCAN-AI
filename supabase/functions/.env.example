# Edge Function server-side secrets. Set these via `supabase secrets set`,
# never commit real values, and never expose any of these to the mobile app
# or website frontend bundle.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # write access — webhooks only

# Stripe (website checkout only — mobile app never touches these)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxx   # $25/yr plan
STRIPE_PRICE_LIFETIME=price_xxx         # $75 lifetime plan
STRIPE_PRICE_PROFESSIONAL=price_xxx     # jeweler/professional plan

# Origin allowed to call create-checkout-session
WEBSITE_ORIGIN=https://gemscan.ai

# Mobile money gateway (Zaad/EVC Plus/Sahal/eDahab) — the webhook verifies a
# real HMAC-SHA256(rawBody, secret) signature, but stays fully disabled (every
# request rejected) until BOTH vars below are set: the shared secret from the
# licensed aggregator (e.g. a WaafiPay-style vendor — see 05-Monetization-
# Legal-Payments.md for the required legal/fintech review), AND the explicit
# enable flag. Setting the secret alone does NOT open the endpoint.
MOBILE_MONEY_GATEWAY_SECRET=changeme
MOBILE_MONEY_GATEWAY_ENABLED=false

# AI Scan Pipeline (orchestrate-scan) — cloud vision providers (Stage 4).
# These NEVER ship in the mobile bundle; the app only ever calls the
# orchestrate-scan Edge Function, never these vendors directly.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash            # optional override
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini                 # optional override
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6           # optional override
# Macrostrat (geological context) needs no API key — it's a free, public,
# CC BY-licensed API.
